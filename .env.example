# Gdzie Polecę — skopiuj do .env i uzupełnij. Brak klucza = źródło wyłączone.

# --- Źródła lotów (1 = włączone) ---
# Dane testowe, deterministyczne; działa bez kluczy.
SOURCE_MOCK=1
# Travelpayouts / Aviasales Data API (faza 1). Token i marker z panelu partnera.
SOURCE_TRAVELPAYOUTS=0
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Endpoint cen: latest48h (/v2/prices/latest, ceny z 48 h) | prices7d (prices_for_dates, cache do 7 dni)
# | both (najpierw 48 h, zapasowo 7 dni dla zadań bez wyników).
TRAVELPAYOUTS_MODE=both
# Kiwi.com: opcjonalny identyfikator afiliacyjny dla deep-linków "sprawdź w Kiwi.com" (param affilid).
KIWI_AFFILIATE_ID=
# Duffel (faza 2): ceny na żywo linii regularnych (LOT, Lufthansa Group, Qatar, Emirates; bez Ryanaira
# i Wizz Aira). Płatne za wyszukiwanie (0,005 USD po 1500 darmowych na rezerwację), więc tylko dla
# konkretnych zapytań (do 2 lotnisk, okno dat do 3 dni) i na przycisk "Sprawdź na żywo".
# Opis: packages/core/src/sources/duffel/README.md.
SOURCE_DUFFEL=0
DUFFEL_ACCESS_TOKEN=
# test | live: tylko etykieta ofert ("tryb testowy Duffel"); o trybie decyduje token (duffel_test_ / duffel_live_).
DUFFEL_MODE=test
# Twardy dzienny limit płatnych wyszukiwań (doba liczona w czasie polskim). Po wyczerpaniu: ceny z cache.
DUFFEL_DAILY_SEARCH_BUDGET=200
# Atrapa Duffela bez sieci (testy e2e, pokazy). Nigdy na produkcji: ceny są zmyślone i tak oznaczone.
SOURCE_DUFFEL_MOCK=0
# Czartery (faza 3): feedy produktowe touroperatorów z sieci afiliacyjnych (TravelLead, Tradedoubler,
# Awin, Admitad, własne XML). Opis: packages/core/src/sources/charters/README.md.
SOURCE_CHARTERS=0
# Plik JSON z listą feedów (domyślnie <repo>/config/charter-feeds.json; wzór: config/charter-feeds.example.json).
CHARTER_FEEDS_FILE=
# Import w procesie serwera co N minut (0 = wyłączony; wtedy cron: node scripts/charters/import.mjs).
# Każdy feed i tak jest pobierany najwyżej raz na swoje refreshMinutes.
CHARTER_IMPORT_INTERVAL_MINUTES=360
# Sekrety i identyfikatory partnera feedów: nazwy zmiennych wybierasz w konfiguracji (auth.*.valueEnv,
# {env:NAZWA}); przykład z config/charter-feeds.example.json:
# TRAVELLEAD_FEED_TOKEN=
# TRAVELLEAD_PARTNER_ID=
# TRADEDOUBLER_FEED_ID=
# TRADEDOUBLER_FEED_AUTH=

# --- Cache ---
# sqlite (domyślnie; bez natywnego modułu spada do pamięci) | memory
CACHE_DRIVER=sqlite
CACHE_PATH=.cache/gdziepolece.sqlite

# --- Wyszukiwanie ---
# Twardy limit zapytań do źródeł na jedno wyszukiwanie.
SEARCH_MAX_TASKS=500

# --- Dane referencyjne ---
# Katalog z airports.json, regions.json, place-groups.json (domyślnie <repo>/data).
GDZIEPOLECE_DATA_DIR=

# --- Mapa (web) ---
# Styl MapLibre (URL do style.json). Domyślnie OpenFreeMap "liberty", bez klucza. Czytany przy starcie
# serwera (GET /api/v1/config), więc zmiana nie wymaga przebudowy. Gdy styl się nie wczyta, mapa próbuje
# OpenFreeMap "bright", potem demo MapLibre, a na końcu pokazuje uproszczony plan z trasami.
# Starsza nazwa NEXT_PUBLIC_MAP_STYLE_URL nadal działa jako zapasowa.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- SEO (web) ---
# Adres kanoniczny serwisu (bez ścieżki). Z niego powstają canonical, sitemap.xml i robots.txt.
# Żądania na inny host (np. gdziepolece.onrender.com) dostają X-Robots-Tag: noindex i robots.txt
# z "Disallow: /" (bez przekierowania), więc lokalnie (127.0.0.1) strony też są noindex.
# Czytany w czasie działania; strony generowane przy `next build` (strona główna, /szukaj, strony
# prawne) widzą go tylko, gdy jest ustawiony także podczas builda. Domyślnie https://gdziepolece.pl.
PUBLIC_SITE_URL=https://gdziepolece.pl
